{
  "name": "agent-redact",
  "version": "0.1.1",
  "description": "Zero-latency, zero-leak secret & PII redactor for ALL AI Agents, LLMs, and Multi-Agent Workflows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-redact": "dist/cli/index.js",
    "agent-redact-mcp": "dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js",
      "require": "./dist/patterns/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "npm run build && node benchmarks/run.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "security",
    "redaction",
    "secret-scanner",
    "pii-masking",
    "llm-security",
    "claude-code",
    "prompt-security",
    "anthropic",
    "openai",
    "token-masking"
  ],
  "author": "Tony Duong <nguyenhaiduong052005@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyDuongg/agent-redact.git"
  },
  "bugs": {
    "url": "https://github.com/TonyDuongg/agent-redact/issues"
  },
  "homepage": "https://github.com/TonyDuongg/agent-redact#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
